{
  "manifest_version": 3,
  "name": "Penglu",
  "version": "0.1.0",
  "description": "A penguin butler who politely stops impulse purchases.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "js": [
        "src/detector.js",
        "src/price.js",
        "src/pricefinder.js",
        "src/product.js",
        "src/settings.js",
        "src/ledger.js",
        "src/script.js",
        "src/overlay.js",
        "src/content.js"
      ]
    }
  ],
  "action": {
    "default_title": "Penglu",
    "default_popup": "popup/popup.html"
  }
}
